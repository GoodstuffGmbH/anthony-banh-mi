---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { href } from '../i18n/routes';
import { useT } from '../i18n/ui';

const t = useT('de');
const en = useT('en');
---

<Base lang="de" title={t.notFound.title} description={t.notFound.text}>
  <section class="section">
    <div class="container stack">
      <p class="eyebrow">404</p>
      <h1>{t.notFound.title}</h1>
      <p>{t.notFound.text}</p>
      <Button href={href('home', 'de')}>{t.notFound.back}</Button>
      <p lang="en">
        {en.notFound.title}. <a href={href('home', 'en')}>{en.notFound.back}</a>
      </p>
    </div>
  </section>
</Base>

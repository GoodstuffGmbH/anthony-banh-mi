---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/jost';
import '../styles/global.css';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import cormorantLatin from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { type Lang, type RouteKey } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  routeKey?: RouteKey;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
}

const { lang, routeKey, title, description, jsonLd = [], ogImage } = Astro.props;
const t = useT(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {
      /* GitHub Pages setzt keine eigenen Header (.htaccess gilt dort nicht), daher CSP als Meta.
         Nur im Build: Der Dev-Server fügt Styles per JS ein. frame-ancestors wirkt als Meta nicht. */
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        />
      )
    }
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf6ee" />
    <link rel="preload" href={jostLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorantLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {title} {description} {lang} {routeKey} {ogImage} />
    {jsonLd.map((data) => <JsonLd {data} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t.a11y.skip}</a>
    <Header {lang} {routeKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer {lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 100;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    translate: 0 -200%;
  }

  .skip:focus {
    translate: 0 0;
  }

  main:focus {
    outline: none;
  }
</style>

---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { site } from '../data';
import { services } from '../data/services';
import { enabledKeys } from '../lib/services';
import { telHref } from '../lib/format';
import { href, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const hasConsent = enabledKeys(services).length > 0;
---

<footer class="site-footer">
  <div class="container grid">
    <div class="brand">
      <Logo />
    </div>

    <address class="contact">
      <p class="label">{t.nav.contact}</p>
      <p>
        <Icon name="mail" size={18} />
        {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <Placeholder text="E-Mail-Adresse" />}
      </p>
      <p>
        <Icon name="phone" size={18} />
        {site.phone ? <a href={telHref(site.phone)}>{site.phone}</a> : <Placeholder text="Telefonnummer" />}
      </p>
      {
        site.social.map((s) => (
          <p>
            <Icon name="instagram" size={18} />
            <a href={s.url} rel="noopener me" target="_blank">
              {s.label}: @{new URL(s.url).pathname.replaceAll('/', '')}
              <span class="visually-hidden"> ({t.footer.external})</span>
            </a>
          </p>
        ))
      }
    </address>

    <nav aria-label={t.a11y.footerNav}>
      <ul role="list">
        <li><a href={href('imprint', lang)}>{t.nav.imprint}</a></li>
        <li><a href={href('privacy', lang)}>{t.nav.privacy}</a></li>
        <li><a href={href('contact', lang)}>{t.nav.contact}</a></li>
        {
          hasConsent && (
            <li>
              <button type="button" class="linklike" data-consent-open aria-haspopup="dialog">{t.nav.cookies}</button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>© {year} {site.name}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: var(--space-xl) var(--space-md);
    background: var(--color-surface);
    border-top: 3px solid var(--color-wood);
    font-size: var(--fs-small);
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    align-items: start;
  }

  .contact {
    display: grid;
    gap: var(--space-xs);
    font-style: normal;
  }

  .contact p {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .contact p.label {
    color: var(--color-heading);
  }

  ul {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--color-text);
  }

  a:hover,
  .linklike:hover {
    color: var(--color-accent-text);
  }

  .linklike {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .legal {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-surface-strong);
    color: var(--color-text-muted);
  }
</style>

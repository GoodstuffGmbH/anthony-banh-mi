---
import type { MenuItemT } from '../data/schema';
import type { Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  tags: MenuItemT['tags'];
  lang: Lang;
}

const { tags, lang } = Astro.props;
const t = useT(lang);
---

{
  tags.length > 0 && (
    <ul class="tags" role="list">
      {tags.map((tag) => (
        <li class:list={['tag', { diet: tag === 'vegan' || tag === 'vegetarisch' }]}>{t.menu.tags[tag]}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    padding: 0.15em 0.6em;
    background: var(--color-accent);
    color: var(--green-950);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .diet {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
  }
</style>

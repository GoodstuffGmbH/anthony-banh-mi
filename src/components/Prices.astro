---
import Placeholder from './Placeholder.astro';
import type { MenuItemT } from '../data/schema';
import { formatPrice, formatVolume } from '../lib/format';
import type { Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  prices: MenuItemT['prices'];
  lang: Lang;
}

const { prices, lang } = Astro.props;
const t = useT(lang);
---

{
  prices ? (
    <ul class="prices" role="list">
      {prices.map((p) => (
        <li>
          <span class="visually-hidden">{t.menu.price}: </span>
          {p.volume && <span class="volume">{formatVolume(p.volume, lang)}</span>}
          <span class="amount">{formatPrice(p.amount, lang)}</span>
        </li>
      ))}
    </ul>
  ) : (
    <Placeholder text="Preis" />
  )
}

<style>
  .prices {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
    justify-items: end;
  }

  .prices li {
    display: flex;
    gap: var(--space-sm);
    white-space: nowrap;
  }

  .volume {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    align-self: center;
  }

  .amount {
    font-weight: 500;
    color: var(--color-accent-text);
    font-variant-numeric: tabular-nums;
  }
</style>

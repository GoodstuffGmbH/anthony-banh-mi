---
import TextPage from './TextPage.astro';
import { href, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<TextPage {lang} routeKey="privacy" title={t.legal.privacyTitle} seoTitle={t.seo.privacy.title} description={t.seo.privacy.description}>
  {/* Rechtliche Prüfung bestätigt am 19.11.2026. */}
  {
    lang === 'de' ? (
      <>
        <h2>1. Verantwortlicher</h2>
        <p>
          Verantwortlich ist der im <a href={href('imprint', lang)}>Impressum</a> genannte Betreiber.
        </p>

        <h2>2. Hosting über GitHub Pages</h2>
        <p>
          Diese Website wird über GitHub Pages bereitgestellt. Anbieter ist die GitHub B.V., Prins Bernhardplein 200,
          1097 JB Amsterdam, Niederlande, und die GitHub, Inc., 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107,
          USA.
        </p>
        <p>
          Beim Aufruf der Website verarbeitet GitHub technisch notwendige Daten, insbesondere deine IP-Adresse, um die
          Seiten auszuliefern. Nach Angaben von GitHub wird die IP-Adresse von Besucherinnen und Besuchern zu
          Sicherheitszwecken protokolliert und gespeichert. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO; unser
          berechtigtes Interesse ist eine sichere und zuverlässige Bereitstellung der Website. Wie lange GitHub diese
          Daten speichert, gibt GitHub nicht an.
        </p>
        <p>
          Dabei können Daten in die USA übermittelt werden. GitHub gibt an, das EU-U.S. Data Privacy Framework
          einzuhalten (Angemessenheitsbeschluss der EU-Kommission, Art. 45 DSGVO), und stützt Übermittlungen zudem auf
          die Standardvertragsklauseln der EU-Kommission (Art. 46 DSGVO). Mehr dazu im{' '}
          <a href="https://docs.github.com/de/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">
            GitHub General Privacy Statement
          </a>
          .
        </p>

        <h2>3. Keine Cookies, kein Tracking</h2>
        <p>
          Diese Website setzt keine Cookies und verwendet keine Analyse- oder Werbedienste. Schriftarten werden zusammen
          mit der Website ausgeliefert, nicht über Dritte wie Google Fonts.
        </p>

        <h2>4. Kontakt per E-Mail oder Telefon</h2>
        <p>
          Wenn du uns kontaktierst, verarbeiten wir deine Angaben, um die Anfrage zu beantworten. Rechtsgrundlage ist
          Art. 6 Abs. 1 lit. b DSGVO bei vertragsbezogenen Anfragen, sonst Art. 6 Abs. 1 lit. f DSGVO.
        </p>

        <h2>5. Externe Links</h2>
        <p>
          Links zu Kartendiensten öffnen eine externe Seite. Erst dann gelten die Datenschutzbestimmungen des jeweiligen
          Anbieters.
        </p>

        <h2>6. Deine Rechte</h2>
        <p>
          Du hast das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung, Datenübertragbarkeit
          und Widerspruch (Art. 15 bis 21 DSGVO) sowie das Recht auf Beschwerde bei einer Datenschutz-Aufsichtsbehörde
          (Art. 77 DSGVO).
        </p>
      </>
    ) : (
      <>
        <p>
          The legally binding version of this page is the{' '}
          <a href={href('privacy', 'de')} hreflang="de" lang="de">
            German Datenschutzerklärung
          </a>
          .
        </p>
        <h2>Summary</h2>
        <ul>
          <li>This website sets no cookies and uses no analytics or advertising services.</li>
          <li>Fonts are delivered with the website, not via third parties such as Google Fonts.</li>
          <li>
            The site is hosted on GitHub Pages (GitHub B.V., Amsterdam, and GitHub, Inc., San Francisco, USA). GitHub
            processes technically necessary data, in particular your IP address, to deliver the site and logs it for
            security purposes (Art. 6(1)(f) GDPR). Data may be transferred to the USA; GitHub states that it complies
            with the EU-U.S. Data Privacy Framework and uses the EU standard contractual clauses.
          </li>
          <li>If you contact us, we use your details only to answer your request.</li>
          <li>You have the rights under Art. 15 to 21 and Art. 77 GDPR.</li>
        </ul>
      </>
    )
  }
</TextPage>

---
import { Image } from 'astro:assets';
import TextPage from './TextPage.astro';
import Placeholder from '../components/Placeholder.astro';
import { image } from '../data';
import { showAboutStory, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<TextPage {lang} routeKey="about" title={t.about.title} lead={t.about.lead} seoTitle={t.seo.about.title} description={t.seo.about.description}>
  <Image src={image('logo-portrait')} alt={t.about.portraitAlt} width={200} height={200} densities={[1, 2]} class="portrait" />

  {
    showAboutStory && (
      <>
        <h2 id="geschichte">{t.about.story}</h2>
        <Placeholder block text="Geschichte von Anthony und dem Laden (Herkunft, Gründung, Jahr) – Text vom Restaurant" />
      </>
    )
  }

  <h2 id="konzept">{t.about.concept}</h2>
  {
    lang === 'de' ? (
      <>
        <p>
          Bánh mì ist das vietnamesische Baguette-Sandwich: knuspriges Brot, herzhafte Füllung, eingelegtes Gemüse und
          frische Kräuter. Bei uns gibt es dazu Kaffee und eine eigene vegane und vegetarische Auswahl.
        </p>
        <p>
          Unser Baguette wird speziell für uns von Elias Boulanger gebacken. Jedes Bánh mì bekommt dieselbe Basis:
          eingelegte Karotten, eingelegten Rettich, Gurke, Koriander, Jasmin-Zitronengras-Soße und scharfe
          Tamarind-Soße. Die vietnamesische Leberwurst im Bánh Mì Thịt Kho folgt Mamas Rezept.
        </p>
        <p>
          Für unseren Kaffee verwenden wir vietnamesische Bohnen, frisch geröstet in Deutschland, für Matcha High
          Ceremonial Grade von Mori Kyoto. Die Eistees Trà Chanh Đá und Trà Đào sowie den alkoholfreien Lychee x Yuzu
          Spritz machen wir selbst.
        </p>
      </>
    ) : (
      <>
        <p>
          Bánh mì is the Vietnamese baguette sandwich: crisp bread, a savoury filling, pickled vegetables and fresh
          herbs. We also serve coffee and our own vegan and vegetarian selection.
        </p>
        <p>
          Our baguette is baked especially for us by Elias Boulanger. Every bánh mì starts from the same base: pickled
          carrots, pickled radish, cucumber, coriander, jasmine lemongrass sauce and spicy tamarind sauce. The
          Vietnamese liver pâté in our Bánh Mì Thịt Kho follows Mum's recipe.
        </p>
        <p>
          For our coffee we use Vietnamese beans, freshly roasted in Germany, and for matcha high ceremonial grade from
          Mori Kyoto. Our iced teas Trà Chanh Đá and Trà Đào and the alcohol-free Lychee x Yuzu Spritz are homemade.
        </p>
      </>
    )
  }
</TextPage>

<style>
  .portrait {
    border-radius: 50%;
    margin-bottom: var(--space-lg);
  }
</style>
